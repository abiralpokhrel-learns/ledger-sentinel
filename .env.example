# Ledger Sentinel — environment template
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Webhook HMAC secret shared with Razorpay (test mode)
WEBHOOK_SECRET=your_webhook_secret_here

# Razorpay test-mode API credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Merchant token used for the Remote MCP server (Bearer)
RAZORPAY_MERCHANT_TOKEN=your_merchant_token

# Remote MCP endpoint (used if LEDGER_MCP_MODE=remote)
RAZORPAY_MCP_URL=https://mcp.razorpay.com/mcp

# MCP deployment mode: "remote" or "local"
LEDGER_MCP_MODE=remote

# Anthropic API key for exception classification
ANTHROPIC_API_KEY=your_anthropic_api_key

# Classification model
ANTHROPIC_MODEL=claude-sonnet-4-6

# Path where the SQLite database is written
LEDGER_DB_PATH=ledger_sentinel.db
